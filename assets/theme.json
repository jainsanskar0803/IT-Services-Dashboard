{
  "name": "IT Services Corporate Dark",
  "dataColors": [
    "#38BDF8",
    "#A78BFA",
    "#F59E0B",
    "#10B981",
    "#F43F5E",
    "#64748B",
    "#E2E8F0",
    "#0EA5E9"
  ],
  "background": "#0F1117",
  "foreground": "#E2E8F0",
  "tableAccent": "#38BDF8",
  "visualStyles": {
    "*": {
      "*": {
        "fontFamily": [{ "value": "Segoe UI" }],
        "fontSize": [{ "value": 10 }],
        "color": [{ "solid": { "color": "#E2E8F0" } }],
        "background": [{ "solid": { "color": "#1C2333" } }]
      }
    },
    "card": {
      "*": {
        "background": [{ "solid": { "color": "#1C2333" } }],
        "border": [{ "solid": { "color": "#2A3248" } }],
        "dataLabel": [{
          "color": { "solid": { "color": "#E2E8F0" } },
          "fontSize": 24,
          "fontFamily": "Segoe UI Light"
        }],
        "categoryLabel": [{
          "color": { "solid": { "color": "#64748B" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI",
          "show": true
        }]
      }
    },
    "lineChart": {
      "*": {
        "background": [{ "solid": { "color": "#1C2333" } }],
        "plotArea": [{ "transparency": 100 }],
        "categoryAxis": [{
          "gridlineColor": { "solid": { "color": "#2A3248" } },
          "labelColor": { "solid": { "color": "#64748B" } }
        }],
        "valueAxis": [{
          "gridlineColor": { "solid": { "color": "#2A3248" } },
          "labelColor": { "solid": { "color": "#64748B" } }
        }]
      }
    },
    "barChart": {
      "*": {
        "background": [{ "solid": { "color": "#1C2333" } }],
        "categoryAxis": [{
          "gridlineColor": { "solid": { "color": "#2A3248" } },
          "labelColor": { "solid": { "color": "#64748B" } }
        }],
        "valueAxis": [{
          "gridlineColor": { "solid": { "color": "#2A3248" } },
          "labelColor": { "solid": { "color": "#64748B" } }
        }]
      }
    },
    "donutChart": {
      "*": {
        "background": [{ "solid": { "color": "#1C2333" } }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "solid": { "color": "#161B27" } }],
        "data": [{
          "fontColor": { "solid": { "color": "#94A3B8" } },
          "fontSize": 10
        }],
        "header": [{
          "fontColor": { "solid": { "color": "#64748B" } },
          "background": { "solid": { "color": "#0F1117" } }
        }]
      }
    },
    "tableEx": {
      "*": {
        "background": [{ "solid": { "color": "#1C2333" } }],
        "grid": [{
          "gridVertical": false,
          "gridHorizontalColor": { "solid": { "color": "#2A3248" } },
          "rowPadding": 6
        }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#64748B" } },
          "backColor": { "solid": { "color": "#161B27" } },
          "fontSize": 9,
          "fontFamily": "Segoe UI",
          "bold": true
        }],
        "values": [{
          "fontColor": { "solid": { "color": "#94A3B8" } },
          "backColor": { "solid": { "color": "#1C2333" } },
          "fontSize": 10
        }]
      }
    }
  }
}
